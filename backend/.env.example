# --- Required: speech providers ---
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# --- LLM: OpenRouter (default when set) or Groq ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=                 # openrouter | groq (empty = auto)

# --- Twilio (outbound calls via make_outbound_call.py) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=
# Public wss:// URL of this server (Render / ngrok)
VOICE_AGENT_WSS_URL=

# --- Optional tuning ---
MYRA_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
MYRA_LLM_FALLBACK_MODELS=openai/gpt-4o-mini   # OpenRouter only, comma-separated
MYRA_LANGUAGE=auto            # auto | english | hinglish
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
SARVAM_SPEAKER=simran
TTS_SAMPLE_RATE=16000
REDIS_URL=                    # empty = local customers.json CRM

# --- Project facts used in the agent prompt ---
PROPVOX_COMPANY=PropVox Realty
PROPVOX_PROJECT=PropVox Estate
PROPVOX_LOCATION=Sector 12, NH-44 corridor
PROPVOX_SIZE=20-acre plotted township
PROPVOX_PRICE=Plots start from ₹30 lakh. Sizes range from 100 to 300 sqyd.

# Opt-in: skip TLS verification for Twilio API calls (only if your network intercepts TLS)
TWILIO_INSECURE_SSL=
